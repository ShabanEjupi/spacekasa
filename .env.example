# PayPal REST app (developer.paypal.com → Apps & Credentials). Sandbox by default.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Any OpenAI-compatible chat-completions endpoint with tool calling.
LLM_URL=https://api.openai.com/v1
LLM_KEY=
LLM_MODEL=gpt-4o-mini
# Public URL of this app (PayPal returns the customer here after paying).
BASE_URL=http://localhost:8080
